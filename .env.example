# FreightDesk configuration. Copy to .env and edit. Every value is optional.

# HTTP port the API and the built client are served on.
PORT=4000


# SQLite database file. Defaults to <project>/data/freightdesk.db
# DB_PATH=C:/freightdesk/data/freightdesk.db

# How long a signed-in session stays valid, in days.
SESSION_TTL_DAYS=7

# Shared secret for inbound channel webhooks. Sent by the provider as the
# x-webhook-token header (or ?token= query parameter). Change this before
# exposing the server.
WEBHOOK_TOKEN=freightdesk-local-test-928374-change-this

# In live mode, how long outreach waits for a vendor reply before the attempt
# is marked no_response. Default 15 minutes.
# REPLY_TIMEOUT_MS=900000

# --- Twilio WhatsApp Sandbox -----------------------------------------------
# Leave these unset to keep WhatsApp outreach in simulation mode. For live
# messages, use the Twilio WhatsApp Sandbox sender shown in Twilio Console.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional text template. Supported placeholders: {vendor_name}, {vehicle_type}, {body_size},
# {weight}, {origin}, {destination}, {date}, {time}
WHATSAPP_TEMPLATE=Hello {vendor_name}, we need a {vehicle_type} ({body_size}) for {weight} tonnes from {origin} to {destination}. Loading: {date}, {time}. Please reply with your best rate (Rs.) for this trip.

# --- Twilio voice -----------------------------------------------------------
# Leave all three unset to keep voice in simulation mode. With them set, voice
# outreach places real calls that read the requirement script.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+911100001111

# --- Sarvam AI voice --------------------------------------------------------
# With these set, the "Sarvam AI price enquiry" panel places a real instant
# outbound call through Sarvam Voice Agents. Leave them unset to keep the panel
# in its not-configured state.
SARVAM_API_KEY=sk_samvaad_7h10z45n_J4QKbsjKgIFXo2nvK6lLGU38
SARVAM_ORG_ID=01a18dbb-ecf8-79bb-b693-a845764a0252
SARVAM_VOICE_API_KEY=
SARVAM_WORKSPACE_ID=01a18dbb-ed00-7c3b-8f1e-f8bb585b5d01
SARVAM_APP_ID=0b570223-9f-78669e0e-c0af
 SARVAM_CONNECTION_ID=01a18dbb-f112-706f-85f5-4e78a63118cf
 SARVAM_AGENT_PHONE_NUMBER=+918064270125
# Optional: Sarvam chat model used to write the enquiry script.
SARVAM_MODEL_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v4
# Public URL of POST /api/webhooks/sarvam, including ?token=<WEBHOOK_TOKEN>,
# so Sarvam can post the call transcript back.
 SARVAM_WEBHOOK_URL=https://api.sarvam.ai/v1/workspaces/01a18dbb-ed00-7c3b-8f1e-f8bb585b5d01/apps/0b570223-9f-78669e0e-c0af/webhook
# The only number this build may call. Defaults to David Transportation.
 SARVAM_VENDOR_NAME=David Transportation
SARVAM_VENDOR_PHONE=6385106931
