# Required Render + Sarvam configuration. Replace every placeholder.
PORT=4000
NODE_VERSION=22
DB_PATH=/var/lib/freightdesk/freightdesk.db
WEBHOOK_TOKEN=<long-random-secret>

SARVAM_API_KEY=<sarvam-model-api-key>
SARVAM_VOICE_API_KEY=<sarvam-voice-agents-workspace-api-key>
SARVAM_ORG_ID=<sarvam-organization-id>
SARVAM_WORKSPACE_ID=<sarvam-workspace-id>
SARVAM_APP_ID=<sarvam-voice-agent-app-id>
SARVAM_CONNECTION_ID=<sarvam-connection-id>
SARVAM_AGENT_PHONE_NUMBER=+91XXXXXXXXXX
SARVAM_WEBHOOK_URL=https://<your-service>.onrender.com/api/webhooks/sarvam?token=<same-WEBHOOK_TOKEN>
